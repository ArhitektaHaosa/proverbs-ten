# ---- Site identity (the ONLY place domain/name/contact may live) ----
SITE_NAME="Proverbs Ten"
SITE_TAGLINE="Wisdom of the world, one proverb at a time"
APP_URL=https://proverbs.admin.education
CONTACT_EMAIL=proverbs@admin.education

# false = X-Robots-Tag noindex + robots.txt Disallow (use on the temporary domain)
SITE_INDEXABLE=false

# ---- Laravel ----
APP_NAME="${SITE_NAME}"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=proverbs
DB_USERNAME=proverbs
DB_PASSWORD=

QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_DRIVER=file

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="${CONTACT_EMAIL}"
MAIL_FROM_NAME="${SITE_NAME}"

# ---- AI (free hosted open models; limits change, keep them here) ----
AI_PRIMARY=groq
AI_FALLBACK=openrouter
GROQ_API_KEY=
GROQ_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
AI_THROTTLE_SECONDS=4
AI_DAILY_LIMIT=500
AI_PROMPT_VERSION=v1

# ---- Import ----
# Defaults to CONTACT_EMAIL; used in the User-Agent sent to Wikimedia
WIKTIONARY_CONTACT=

# ---- Moderation / SEO ----
TRUST_AFTER_APPROVED=5
SEO_MIN_ENRICHMENT_SCORE=3

# ---- Monetization / analytics / consent ----
ADSENSE_ENABLED=false
ADSENSE_CLIENT=

ANALYTICS_ENABLED=true
GA4_MEASUREMENT_ID=

CMP_PROVIDER=quantcast
CMP_ID=
# Local development only. Never true in production.
ANALYTICS_ALLOW_WITHOUT_CMP=false

# ---- Filament admin ----
ADMIN_PATH=admin
